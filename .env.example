# Copiá este archivo como .env y ajustá los valores.

# Puerto HTTP (y WebSocket, comparten el mismo servidor)
PORT=3000

# development | production
NODE_ENV=development

# Secreto para firmar las sesiones (cookie). ¡Cambialo en producción!
SESSION_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Duración de la sesión en horas
SESSION_HOURS=12

# Modo de la app (solo afecta la PRIMERA vez que se inicializa la base):
#   demo       → carga productos con imágenes, usuarios de prueba, clientes y promociones
#   produccion → tablas vacías y un único usuario administrador (ADMIN_USER / ADMIN_PASSWORD)
APP_MODE=demo

# Administrador inicial del modo producción. Si ADMIN_PASSWORD queda vacío, se genera
# una contraseña al azar y se muestra una sola vez en la consola al arrancar.
ADMIN_USER=Admin
ADMIN_PASSWORD=

# Zona horaria del local (para "pedidos de hoy", estadísticas, etc.)
APP_TIMEZONE=America/Montevideo

# Conexión MySQL / MariaDB (XAMPP: usuario root sin contraseña por defecto)
# La base de datos se crea automáticamente si no existe.
# En la nube podés usar una sola variable en lugar de las DB_*:
#   DATABASE_URL=mysql://usuario:clave@host:puerto/base
# y activar el cifrado que suelen exigir: DB_SSL=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=autopedido
DB_POOL=10

# URL con la que los celulares llegan al servidor (se usa en el QR de seguimiento).
# Vacío = se detecta sola la IP de la red local, ej. http://192.168.1.20:3000
PUBLIC_URL=

# Detrás de un proxy (Render, Railway, Nginx) poné TRUST_PROXY=1
TRUST_PROXY=

# PIN que se pide para cerrar sesión en el kiosco de autoservicio
KIOSCO_PIN=4500

# Imagen por defecto para productos sin imagen
PRODUCT_PLACEHOLDER=/img/placeholder-producto.svg

# Superadmin oculto (solo el proveedor de la app): configura paquete, licencia, marca, límites y
# módulos en /superadmin. No se guarda en la base ni aparece en Admin → Usuarios.
# Vacío = no hay superadmin. La contraseña debe tener al menos 6 caracteres.
SUPERADMIN_USER=
SUPERADMIN_PASSWORD=
# Clave compartida (la misma en TODAS tus instalaciones, 24 caracteres o más) para ver todas
# desde el panel central del superadmin. Vacío = solo ves esta instalación.
SUPERADMIN_API_KEY=
